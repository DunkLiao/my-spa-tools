# ============================================================
# my-spa-tools 換行與檔案屬性
# 目標：所有文字檔在版本庫與工作區統一使用 LF，
#       避免 core.autocrlf 造成的 CRLF／LF 差異（見 AGENTS.md）。
# ============================================================

# 由 Git 自動判斷文字檔，並在所有平台以 LF 取出
* text=auto eol=lf

# 明確指定常見文字檔為 LF
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf
*.md    text eol=lf
*.ps1   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.svg   text eol=lf

# 二進位檔：不做換行轉換
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.bmp   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
*.zip   binary
*.docx  binary
